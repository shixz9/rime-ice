#!/bin/zsh
# ─────────────────────────────────────────────────────────
# Rime 设置面板 · 启动器（双击运行）
# 启动本地设置中心 http://127.0.0.1:8877/
# 平时不常驻：面板页面全部关闭约 90 秒后服务自动退出；
# 关闭此终端窗口也会立即停止面板
# 配置改动经面板保存并重新部署后生效
# ─────────────────────────────────────────────────────────
cd "$(dirname "$0")" || exit 1
exec /usr/bin/python3 "$(dirname "$0")/others/script/settings_server.py"
